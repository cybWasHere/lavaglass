[Unit]
Description=Lava lamp audio: the music that is playing (any MPRIS player), as five numbers on ws://127.0.0.1:9873 + what/cover over HTTP (loopback only)
After=pipewire.service wireplumber.service

[Service]
ExecStart=/usr/bin/python3 -u %h/.local/share/lavaglass/lamp-audio/lamp-audio.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
